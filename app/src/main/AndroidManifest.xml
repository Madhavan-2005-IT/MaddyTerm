<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets this app ask Termux to run commands (runtime-granted, declared by Termux) -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Package visibility on Android 11+ so we can detect / launch Termux -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="MaddyTerm"
        android:theme="@style/Theme.MaddyTerm">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives command results from Termux through an explicit PendingIntent -->
        <receiver
            android:name=".ResultReceiver"
            android:exported="false" />
    </application>
</manifest>
